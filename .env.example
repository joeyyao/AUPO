# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. .env is git-ignored.
# NEVER commit real credentials.
# ---------------------------------------------------------------------------

# ---- server ----
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development

# ---- courier: Australia Post / StarTrack testbed ----
# Issued by Australia Post for assessment testing only.
AUSPOST_API_BASE=https://digitalapi.auspost.com.au/test/shipping/v1
AUSPOST_API_KEY=
AUSPOST_API_PASSWORD=

# ---- courier: TNT (optional bonus work, not implemented) ----
TNT_USERNAME=
TNT_PASSWORD=
TNT_ACCOUNT=
TNT_WEBLINKING_USERNAME=
TNT_WEBLINKING_PASSWORD=

# ---- behaviour switches ----
# When false, tracking is never called over the network and every shipment is
# reported as unavailable (useful for offline demos / marking).
ENABLE_LIVE_TRACKING=true
# Seconds before a courier HTTP call is abandoned and reported as unavailable.
TRACKING_TIMEOUT_SECONDS=8
# Seconds to cache a courier tracking response in memory.
TRACKING_CACHE_SECONDS=120

# ---- shipping estimate ----
# Origin postcode for the shipment-fee estimate (Ryde, NSW).
SHIPPING_ORIGIN_POSTCODE=2111
